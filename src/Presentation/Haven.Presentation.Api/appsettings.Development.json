{
  "Manifests": {
    "ManifestsPath": "./data/manifests"
  },
  "Backup": {
    "BackupsPath": "./data/backups"
  },
  "Volumes": {
    "RootPath": "./data/volumes"
  },
  "Instance": {
    "DeploymentLogBasePath": "./data/deployments"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    }
  }
}
